meta {
  name: Politica de contrasenas
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/auth/cambiar-clave
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "claveActual": "{{clave}}",
    "claveNueva": "abc"
  }
}

tests {
  test("responde 422 con mensaje en español", function () {
    expect(res.status).to.equal(422);
    expect(res.body.ok).to.equal(false);
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });

  test("explica qué le falta a la contraseña", function () {
    expect(res.body.errores).to.include('Debe tener al menos 8 caracteres.');
  });
}

docs {
  TC-09
}
