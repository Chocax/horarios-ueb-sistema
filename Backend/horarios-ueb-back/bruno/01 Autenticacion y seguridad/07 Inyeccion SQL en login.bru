meta {
  name: Inyeccion SQL en login
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "' OR '1'='1' -- @unibosque.com",
    "clave": "' OR '1'='1"
  }
}

tests {
  test("responde 401 con mensaje en español", function () {
    expect(res.status).to.equal(401);
    expect(res.body.ok).to.equal(false);
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });

  test("no hay error de servidor ni datos expuestos", function () {
    expect(res.status).to.not.equal(500);
    expect(res.body).to.not.have.property('valor');
  });
}

docs {
  TC-04 · Intento de inyección SQL (OWASP A03): JPA usa consultas parametrizadas.
}
