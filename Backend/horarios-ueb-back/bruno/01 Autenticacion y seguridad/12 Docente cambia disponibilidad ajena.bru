meta {
  name: Docente cambia disponibilidad ajena
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/docentes/doc-05/disponibilidad
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "bloques": []
  }
}

tests {
  test("responde 403 con mensaje en español", function () {
    expect(res.status).to.equal(403);
    expect(res.body.ok).to.equal(false);
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });
}

docs {
  TC-13 · Un docente solo puede registrar su propia disponibilidad (RF-04).
}
