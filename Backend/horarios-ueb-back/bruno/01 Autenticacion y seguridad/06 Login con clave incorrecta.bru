meta {
  name: Login con clave incorrecta
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "usuario.inexistente@unibosque.com",
    "clave": "ClaveErrada123"
  }
}

tests {
  test("responde 401 con mensaje en español", function () {
    expect(res.status).to.equal(401);
    expect(res.body.ok).to.equal(false);
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });

  test("el mensaje no revela si el correo existe", function () {
    expect(res.body.mensaje).to.equal('Correo o contraseña incorrectos.');
  });
}

docs {
  TC-03 · Usa un correo inexistente para no activar el bloqueo de 15 minutos de una cuenta real.
}
