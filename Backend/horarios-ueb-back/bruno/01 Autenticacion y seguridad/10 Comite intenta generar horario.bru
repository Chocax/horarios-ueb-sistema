meta {
  name: Comite intenta generar horario
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/periodos/{{periodoAbierto}}/generar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenComite}}
}

tests {
  test("responde 403 con mensaje en español", function () {
    expect(res.status).to.equal(403);
    expect(res.body.ok).to.equal(false);
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });
}

docs {
  TC-06 · El comité solo revisa: el servidor rechaza la acción y la registra en la bitácora.
}
