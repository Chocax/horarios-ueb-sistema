meta {
  name: Usuarios del administrador
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/usuarios
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("lista los usuarios sin contraseñas", function () {
    expect(res.status).to.equal(200);
    expect(res.body.length).to.be.at.least(59);
    expect(JSON.stringify(res.body)).to.not.contain('hash');
  });
  test("todos los docentes tienen usuario", function () {
    expect(res.body.filter(u => u.rol === 'DOCENTE').length).to.be.at.least(55);
  });
}

docs {
  TC-08
}
