meta {
  name: Bitacora vista por un docente
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/bitacora
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

tests {
  test("responde 403 con mensaje en español", function () {
    expect(res.status).to.equal(403);
    expect(res.body.ok).to.equal(false);
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });
}

docs {
