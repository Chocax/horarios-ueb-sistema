meta {
  name: Horario publicado 2026-1
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/versiones/{{versionPublicada}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenComite}}
}

tests {
  test("el comité consulta el horario publicado sin violaciones duras", function () {
    expect(res.status).to.equal(200);
    expect(res.body.estado).to.equal('PUBLICADA');
    expect(res.body.pendientes).to.have.lengthOf(0);
  });
  test("ningún grupo tiene dos sesiones el mismo día (R8)", function () {
    const vistos = new Set();
    res.body.sesiones.forEach(s => {
      const k = s.grupoId + '|' + s.dia;
      expect(vistos.has(k), k).to.equal(false);
      vistos.add(k);
    });
  });
}

docs {
  TC-29
}
