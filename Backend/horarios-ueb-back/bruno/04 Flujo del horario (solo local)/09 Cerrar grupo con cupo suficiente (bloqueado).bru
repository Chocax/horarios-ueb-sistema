meta {
  name: Cerrar grupo con cupo suficiente (bloqueado)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/grupos/{{grupoPrueba}}/cerrar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenCoordinador}}
}

script:pre-request {
  // escribe datos: solo se ejecuta contra el backend local (perfil H2), nunca contra producción
  if (bru.getEnvName() !== 'local') {
    bru.runner.skipRequest();
  }
}

tests {
  test("responde 422 con mensaje en español", function () {
    expect(res.status).to.equal(422);
    expect(res.body.ok).to.equal(false);
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });

  test("solo se cierran grupos por debajo del mínimo", function () {
    expect(res.body.mensaje).to.contain('mínimo');
  });
}

docs {
  TC-31
}
