meta {
  name: Generar propuesta
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/periodos/{{periodoAbierto}}/generar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenCoordinador}}
}

script:pre-request {
  // escribe datos: solo se ejecuta contra el backend local (perfil H2), nunca contra producción
  if (bru.getEnvName() !== 'local') {
    bru.runner.skipRequest();
  }
}

script:post-response {
  if (res.status === 200) {
    const v = res.body.valor;
    bru.setVar('versionGenerada', v.id);
    bru.setVar('sesionId', v.sesiones[0].id);
    bru.setVar('sesionDia', v.sesiones[0].dia);
    bru.setVar('sesionInicio', v.sesiones[0].inicio);
    bru.setVar('sesionDocente', v.sesiones[0].docenteId);
    bru.setVar('sesionAula', v.sesiones[0].aulaId);
    bru.setVar('grupoPrueba', v.sesiones[0].grupoId);
  }
}

tests {
  test("crea la versión en borrador sin grupos pendientes", function () {
    expect(res.status).to.equal(200);
    expect(res.body.valor.estado).to.equal('BORRADOR');
    expect(res.body.valor.pendientes).to.have.lengthOf(0);
    expect(res.body.valor.sesiones.length).to.be.above(250);
  });
  test("genera en menos de 60 s (RNF-01)", function () {
    expect(res.responseTime).to.be.below(60000);
  });
  test("los grupos diurnos casi no tienen clase el sábado", function () {
    const sabado = res.body.valor.sesiones.filter(s => s.dia === 5).length;
    expect(sabado).to.be.below(25);
  });
}

docs {
  TC-19
}
