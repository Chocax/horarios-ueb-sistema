meta {
  name: Restaurar como borrador
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/versiones/{{versionGenerada}}/restaurar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenCoordinador}}
}

script:pre-request {
  // escribe datos: solo se ejecuta contra el backend local (perfil H2), nunca contra producción
  if (bru.getEnvName() !== 'local') {
    bru.runner.skipRequest();
  }
}

script:post-response {
  if (res.status === 200) bru.setVar('versionRestaurada', res.body.valor.id);
}

tests {
  test("crea una versión nueva en borrador sin tocar la publicada", function () {
    expect(res.status).to.equal(200);
    expect(res.body.valor.estado).to.equal('BORRADOR');
    expect(res.body.valor.id).to.not.equal(bru.getVar('versionGenerada'));
  });
}

docs {
  TC-25
}
