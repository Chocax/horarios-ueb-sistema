meta {
  name: Mover sesion al almuerzo (R3)
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/versiones/{{versionGenerada}}/sesiones/{{sesionId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCoordinador}}
}

body:json {
  {
    "dia": 0,
    "inicio": 13,
    "docenteId": "{{sesionDocente}}",
    "aulaId": "{{sesionAula}}"
  }
}

script:pre-request {
  // escribe datos: solo se ejecuta contra el backend local (perfil H2), nunca contra producción
  if (bru.getEnvName() !== 'local') {
    bru.runner.skipRequest();
  }
}

tests {
  test("responde 422 con mensaje en español", function () {
    expect(res.status).to.equal(422);
    expect(res.body.ok).to.equal(false);
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });

  test("nombra la regla R3", function () {
    expect(res.body.violaciones.map(v => v.regla)).to.include('R3');
  });
}

docs {
  TC-21
}
