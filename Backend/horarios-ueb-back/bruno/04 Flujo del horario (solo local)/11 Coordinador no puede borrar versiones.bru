meta {
  name: Coordinador no puede borrar versiones
  type: http
  seq: 11
}

delete {
  url: {{baseUrl}}/periodos/{{periodoAbierto}}/versiones
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenCoordinador}}
}

script:pre-request {
  // escribe datos: solo se ejecuta contra el backend local (perfil H2), nunca contra producción
  if (bru.getEnvName() !== 'local') {
    bru.runner.skipRequest();
  }
}

tests {
  test("responde 403 con mensaje en español", function () {
    expect(res.status).to.equal(403);
    expect(res.body.ok).to.equal(false);
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });
}

docs {
  TC-37
}
