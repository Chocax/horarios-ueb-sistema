meta {
  name: Periodo repetido
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/periodos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCoordinador}}
}

body:json {
  {
    "anio": 2026,
    "semestre": 2,
    "copiarOferta": false,
    "basePeriodoId": null
  }
}

tests {
  test("responde 422 con mensaje en español", function () {
    expect(res.status).to.equal(422);
    expect(res.body.ok).to.equal(false);
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });

  test("avisa que el periodo ya existe", function () {
    expect(res.body.mensaje).to.contain('ya existe');
  });
}

docs {
  TC-16
}
