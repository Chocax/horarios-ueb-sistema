meta {
  name: Numero de grupos que excede el cupo
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/periodos/{{periodoAbierto}}/cursos/cur-isi-101/numero-grupos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCoordinador}}
}

body:json {
  {
    "numero": 1
  }
}

tests {
  test("responde 422 con mensaje en español", function () {
    expect(res.status).to.equal(422);
    expect(res.body.ok).to.equal(false);
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });

  test("explica el cupo efectivo (R9)", function () {
    expect(res.body.mensaje).to.contain('R9');
  });
}

docs {
  TC-18
}
