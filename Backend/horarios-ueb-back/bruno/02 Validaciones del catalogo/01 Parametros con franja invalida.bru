meta {
  name: Parametros con franja invalida
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/periodos/{{periodoAbierto}}/parametros
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCoordinador}}
}

body:json {
  {
    "franjaLunesViernes": {
      "inicio": 22,
      "fin": 7
    },
    "franjaSabado": {
      "inicio": 7,
      "fin": 13
    },
    "bloquesNoAsignables": [
      {
        "inicio": 13,
        "fin": 14
      }
    ],
    "duracionSesion": 2,
    "cupoMaximo": 40,
    "toleranciaCupo": 10,
    "cupoMinimo": 10,
    "sesionesMinimas": 1,
    "sesionesMaximas": 4,
    "horasMaxPorVinculacion": {
      "TIEMPO_COMPLETO": 16,
      "TRES_CUARTOS": 12,
      "MEDIO_TIEMPO": 8,
      "CUARTO_TIEMPO": 4
    }
  }
}

tests {
  test("responde 422 con mensaje en español", function () {
    expect(res.status).to.equal(422);
    expect(res.body.ok).to.equal(false);
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });

  test("nombra el parámetro inválido", function () {
    expect(res.body.errores).to.include('La franja de lunes a viernes no es válida.');
  });
}

docs {
  TC-10
}
