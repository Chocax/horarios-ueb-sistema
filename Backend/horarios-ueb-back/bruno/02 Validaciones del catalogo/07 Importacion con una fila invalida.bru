meta {
  name: Importacion con una fila invalida
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/periodos/{{periodoAbierto}}/importacion
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCoordinador}}
}

body:json {
  {
    "aulas": [
      {
        "id": "aula-prueba-ok",
        "codigo": "Z-101",
        "nombre": "Salón Z-101",
        "capacidad": 30,
        "caracteristicas": [],
        "bloque": "Z",
        "piso": 1
      },
      {
        "id": "aula-prueba-mal",
        "codigo": "Z-102",
        "nombre": "Salón Z-102",
        "capacidad": -5,
        "caracteristicas": [],
        "bloque": "Z",
        "piso": 1
      }
    ],
    "resumen": "Prueba todo o nada"
  }
}

tests {
  test("responde 422 con mensaje en español", function () {
    expect(res.status).to.equal(422);
    expect(res.body.ok).to.equal(false);
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });

  test("no se carga ninguna fila (todo o nada)", function () {
    expect(res.body.errores.join(' ')).to.contain('Z-102');
  });
}

docs {
  TC-17
}
