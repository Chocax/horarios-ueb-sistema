meta {
  name: Horario de atencion de 3 horas
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/atencion
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "id": "ate-prueba",
    "periodoId": "{{periodoAbierto}}",
    "docenteId": "doc-04",
    "cursoId": "cur-isi-705",
    "modo": "HORARIO",
    "dia": 4,
    "inicio": 7,
    "fin": 10,
    "lugar": "Prueba"
  }
}

tests {
  test("responde 422 con mensaje en español", function () {
    expect(res.status).to.equal(422);
    expect(res.body.ok).to.equal(false);
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });

  test("el horario de atención es de 1 o 2 horas", function () {
    expect(res.body.errores).to.include('El horario de atención es de 1 o 2 horas a la semana.');
  });
}

docs {
  TC-33
}
