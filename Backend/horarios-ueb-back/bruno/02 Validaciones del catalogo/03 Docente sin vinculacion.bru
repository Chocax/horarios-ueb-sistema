meta {
  name: Docente sin vinculacion
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/docentes/doc-prueba-01
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCoordinador}}
}

body:json {
  {
    "id": "doc-prueba-01",
    "identificador": "D9001",
    "nombre": "Docente de prueba",
    "correoInstitucional": "dprueba@unibosque.com",
    "tipoVinculacion": null,
    "categoriaEscalafon": "Asistente",
    "horasMaxDocencia": 8,
    "habilitaciones": [],
    "disponibilidad": []
  }
}

tests {
  test("responde 422 con mensaje en español", function () {
    expect(res.status).to.equal(422);
    expect(res.body.ok).to.equal(false);
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });

  test("pide la vinculación", function () {
    expect(res.body.errores).to.include('Seleccione el tipo de vinculación.');
  });
}

docs {
  TC-12
}
