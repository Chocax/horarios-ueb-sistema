meta {
  name: Grupo con cupo 45 (R9)
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/grupos/grp-2026-2-isi-101-g1
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCoordinador}}
}

body:json {
  {
    "id": "grp-2026-2-isi-101-g1",
    "periodoId": "{{periodoAbierto}}",
    "cursoId": "cur-isi-101",
    "codigo": "G1",
    "jornada": "DIURNA",
    "cupoPlaneado": 45,
    "inscritos": null,
    "estado": "ABIERTO",
    "docentePreferido": null
  }
}

tests {
  test("responde 422 con mensaje en español", function () {
    expect(res.status).to.equal(422);
    expect(res.body.ok).to.equal(false);
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });

  test("cita la regla R9 y el cupo efectivo de 44", function () {
    expect(res.body.mensaje).to.contain('R9');
    expect(res.body.mensaje).to.contain('44');
  });
}

docs {
  TC-11
}
