meta {
  name: Aula sin capacidad
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/aulas/aula-a-201
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCoordinador}}
}

body:json {
  {
    "id": "aula-a-201",
    "codigo": "A-201",
    "nombre": "Sala de cómputo A-201",
    "capacidad": 0,
    "caracteristicas": [
      "EQUIPOS_COMPUTO"
    ],
    "bloque": "A",
    "piso": 2
  }
}

tests {
  test("responde 422 con mensaje en español", function () {
    expect(res.status).to.equal(422);
    expect(res.body.ok).to.equal(false);
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });
}

docs {
  TC-15
}
