meta {
  name: Curso con sesiones fuera de rango
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/cursos/cur-isi-101
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCoordinador}}
}

body:json {
  {
    "curso": {
      "id": "cur-isi-101",
      "codigo": "ISI-101",
      "nombre": "Matemáticas básicas",
      "nivel": 1,
      "creditos": 3,
      "sesionesSemanales": 9,
      "tipo": "OBLIGATORIA",
      "caracteristicasRequeridas": []
    },
    "periodoId": "{{periodoAbierto}}",
    "demanda": null
  }
}

tests {
  test("responde 422 con mensaje en español", function () {
    expect(res.status).to.equal(422);
    expect(res.body.ok).to.equal(false);
    expect(res.body.mensaje).to.be.a('string').and.not.empty;
  });
}

docs {
  TC-14
}
